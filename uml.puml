@startuml ProjectUML
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F0F0F0
skinparam classBorderColor #333333

enum ItemType {
    MASK
    RULE
    LETTER
}

enum RuleType {
    COLOR
    QUALITY
    THEME
    INSIGNIA
}

enum CursorMode {
    NORMAL
    INSPECTING
}

enum InspectionStatus {
    UNRELATED
    MATCHED
    MISMATCHED
}

struct InspectionZone {
    +BoxCollider2D collider
    +AttributeSO attributeValue
}

struct GuestMaskPair {
    +MaskSO mask
    +GuestSO guest
}

class AttributeSO <<ScriptableObject>> {
    +RuleType category
    +string displayName
}

class ItemSO <<ScriptableObject>> {
    +string itemName
    +ItemType itemType
    +Sprite itemSprite
    +Vector2 alignmentOffset
}

class MaskSO <<ItemSO>> {
    +AttributeSO color
    +AttributeSO quality
    +AttributeSO theme
    +Vector3 scaleOffset
}

class SorSO <<ItemSO>> {
    +AttributeSO[] color
    +AttributeSO[] quality
    +AttributeSO[] theme
}

class GuestSO <<ScriptableObject>> {
    +string guestName
    +Sprite guestSprite
    +bool isLegit
    +bool willFight
    +ConversationSO conversation
}

class GuestlistSO <<ScriptableObject>> {
    +int dayNumber
    +GuestMaskPair[] guestList
}

class GuestItemManager <<MonoBehaviour>> {
    +static GuestItemManager Instance
    +bool inspectionMode
    +Canvas canvas
    +RectTransform itemsCanvas
    +RectTransform tablePanel
    +RectTransform guestsPanel
    +RectTransform guestSpawnPosition
    +RectTransform guestStandPosition
    +GameObject SetupMask(MaskSO maskSO, RectTransform parentPanel)
    +void TransferMask()
    +void TransferMaskBackToGuest()
    +GameObject SetupGuest(GuestSO guestSO, MaskSO maskSO)
    +GameObject SetupSOR(SorSO sorSO, RectTransform parentPanel)
    +GameObject SetupSOR(int index, RectTransform parentPanel)
    +void SelectAttributeForInspection(AttributeSO[] attributeData, Item sourceItem)
    +void SelectAttributeForInspection(AttributeSO attributeData, Item sourceItem)
    +void ClearInspectionSelection()
    +void ToggleInspectionMode(bool value)
    +void ToggleInspectionMode()
    +void TeleportUIElement(GameObject teleportee, float xPos, float yPos)
    +void TeleportUIElement(GameObject teleportee, RectTransform destinationTarget)
    +IEnumerator MoveUIElement(GameObject movee, float xPos, float yPos, float timeInSeconds)
    +IEnumerator MoveUIElement(GameObject movee, RectTransform destinationTarget, float timeInSeconds)
    +IEnumerator HopUIElement(GameObject movee, float xPos, float yPos, float timeInSeconds, int hops, float hopHeight)
    +IEnumerator HopUIElement(GameObject movee, RectTransform destinationTarget, float timeInSeconds, int hops, float hopHeight)
    +IEnumerator ShadowHopUIElement(GameObject movee, RectTransform destinationTarget, float timeInSeconds, int hops, float hopHeight)
    +IEnumerator WalkForwardAndOutRoutine(GameObject movee, float timeInSeconds, int hops, float hopHeight)
    +IEnumerator ScaleAndFadeRoutine(GameObject movee, float timeInSeconds)
}

class Item <<MonoBehaviour>> {
    +GuestItemManager guestItemManager
    +RectTransform rt
    +Canvas canvas
    +CanvasGroup canvasGroup
    +virtual void Awake()
    +virtual void Start()
    +virtual void Initialize(ItemSO itemSO)
    +void ToggleDraggable(bool value)
    +virtual void ToggleInspectable(bool value)
}

class Item_Mask <<Item>> {
    +void Initialize(MaskSO maskSO)
    +override void ToggleInspectable(bool value)
    +void maskAttributeZoneClicked()
}

class Item_SOR <<Item>> {
    +void Initialize(SorSO scrollSO)
    +override void ToggleInspectable(bool value)
    +void ColorAttributeZoneClicked()
    +void QualityAttributeZoneClicked()
    +void ThemeAttributeZoneClicked()
}

class Guest <<MonoBehaviour>> {
    +GuestSO guestAssigned
    +RectTransform maskPinRect
    +void Initialize(GuestSO guestSO)
}

class MicroManager <<MonoBehaviour>> {
    +bool debugSkipCutscenes
    +bool debugSkipInstructions
    +MicroStateMachine StateMachine
    +MicroCutsceneState CutsceneState
    +MicroInstructionsState InstructionsState
    +MicroNextGuestState NextGuestState
    +MicroInspectionState InspectionState
    +MicroDecisionState DecisionState
    +GuestItemManager guestItemManager
    +GuestlistSO[] guestListSO
    +SorSO[] dailyRules
    +CutsceneSO[] dailyCutscenes
    +DialogueSO[] dailyDialogues
    +int currentDay
    +int currentGuest
    +int currentLives
    +GameObject activeGuest
    +MaskSO activeMask
    +TextMeshProUGUI mismatchFoundIndicatorText
    +Color defaultMismatchColor
    +Color triggeredMismatchColor
    +bool lastDecisionWasApprove
    +bool isMismatchProven
    +bool hasSpawnedSORForToday
}

class MicroStateMachine {
    +MicroState currentState
    +void Initialize(MicroState startingState)
    +void ChangeState(MicroState newState)
}

class MicroState {
    +MicroManager manager
    +MicroStateMachine stateMachine
    +virtual void EnterState()
    +virtual void ExitState()
    +virtual void UpdateState()
    +virtual void FixedUpdateState()
}

class MicroCutsceneState <<MicroState>> {
}

class MicroInstructionsState <<MicroState>> {
}

class MicroNextGuestState <<MicroState>> {
    -MaskSO currentMask
    -GuestSO currentGuest
}

class MicroInspectionState <<MicroState>> {
}

class MicroDecisionState <<MicroState>> {
}

class macroManager <<MonoBehaviour>> {
}

class macroStateMachine <<MonoBehaviour>> {
}

class macroState <<MonoBehaviour>> {
}

class macroMenuState <<MonoBehaviour>> {
}

class macroGameplayState <<MonoBehaviour>> {
}

GuestItemManager --> Item : manages
GuestItemManager --> Item_Mask : creates
GuestItemManager --> Item_SOR : creates
GuestItemManager --> Guest : manages
GuestItemManager --> MaskSO : references
GuestItemManager --> GuestSO : references
GuestItemManager --> SorSO : references
GuestItemManager --> AttributeSO : references

Item_Mask --|> Item
Item_SOR --|> Item
MaskSO --|> ItemSO
SorSO --|> ItemSO

Guest --> GuestSO : assigned
Item_Mask --> MaskSO : assigned
Item_SOR --> SorSO : assigned

MaskSO --> AttributeSO : has
SorSO --> AttributeSO : has

GuestlistSO --> GuestMaskPair : contains
GuestMaskPair --> MaskSO
GuestMaskPair --> GuestSO

MicroManager --> MicroStateMachine : has
MicroManager --> MicroCutsceneState : has
MicroManager --> MicroInstructionsState : has
MicroManager --> MicroNextGuestState : has
MicroManager --> MicroInspectionState : has
MicroManager --> MicroDecisionState : has
MicroManager --> GuestItemManager : uses

MicroStateMachine --> MicroState : manages
MicroState --> MicroManager : uses
MicroState --> MicroStateMachine : uses
MicroNextGuestState --> GuestItemManager : uses

Item --> GuestItemManager : uses

@enduml